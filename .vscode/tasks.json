{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Castor: Prepare",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "prepare"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Castor: Stop services",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Castor: Wait API",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "wait-api"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
