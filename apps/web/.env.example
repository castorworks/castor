# =================================================================
# Castor Web Environment
# =================================================================
# Copy this file to .env.local for local development.

# Backend API origin used by the /api/v1 rewrite, server-side rendering and the
# route guard. Required in production (build and runtime); defaults to
# http://localhost:1234 in development.
CASTOR_API_URL=http://localhost:1234

# Optional browser-side API origin. Leave empty to proxy through /api/v1.
NEXT_PUBLIC_API_URL=

# Set to "true" when building a standalone Next.js bundle for Docker/self-hosting.
BUILD_STANDALONE=

# =================================================================
# Error Tracking (Sentry, optional)
# =================================================================
# Sentry is enabled only when NEXT_PUBLIC_SENTRY_DSN is set and
# NEXT_PUBLIC_SENTRY_DISABLED is not "true".

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DISABLED=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
