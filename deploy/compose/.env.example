PROJECT_NAME=castor
API_IMAGE=castor/castor-api:local
WEB_IMAGE=castor/castor-web:local
# Gateway publish address. Defaults to loopback so plain HTTP is not exposed to
# the network; terminate TLS in front and forward here. Operators terminating
# TLS on another host can set HTTP_BIND=0.0.0.0. Login cookies are Secure outside
# development mode, so plain HTTP other than http://localhost cannot keep a session.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
CASTOR_CORS_ORIGINS=http://localhost:8080
# Instance identifier: Redis key prefix and JWT audience. Must be unique among
# deployments sharing one Redis (lowercase letters, digits, '-'; 1-32 chars).
CASTOR_INSTANCE_ID=castor
# Generate each secret separately. RSA secret must be exactly 32 ASCII bytes;
# the data key (at least 32 bytes) encrypts TOTP and OIDC secrets in the database:
# back it up with the database, changing it makes those secrets unreadable.
CASTOR_JWT_KEY=
CASTOR_RSA_SECRET=
CASTOR_DATA_KEY=
# Public https origin of the site (e.g. https://castor.example.com). Required
# only for OIDC sign-in, whose callback URL is built from it.
CASTOR_PUBLIC_URL=
CASTOR_DEFAULT_ADMIN_PASSWORD=
# Optional: SMS / mail verification codes. Leave empty to disable that channel
# (SMS also needs SignName/TemplateCode, mail needs Host, in config/api.config.toml).
CASTOR_SMS_ACCESS_KEY=
CASTOR_SMS_SECRET_KEY=
CASTOR_MAIL_PASSWORD=
POSTGRES_USER=castor
POSTGRES_DB=castor
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=castor
S3_SECRET_KEY=
S3_BUCKET=castor
# External services: change endpoints and matching credentials above.
CASTOR_DB_HOST=postgres
CASTOR_REDIS_ADDR=redis:6379
CASTOR_S3_ENDPOINT=rustfs:9000
