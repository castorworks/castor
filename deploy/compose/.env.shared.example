# Shared infrastructure for several Castor instances (scripts/deploy-compose.py up shared).
# Copy to .env.shared. These are administrator credentials: only the provisioning script
# uses them (fed to psql and rc on stdin, never in argv); every instance gets its own
# database role and RustFS user.
PROJECT_NAME=castor-shared
# Network the instance APIs join to reach postgres / redis / rustfs.
SHARED_NETWORK=castor-shared
POSTGRES_USER=castor
POSTGRES_DB=postgres
POSTGRES_PASSWORD=
# Shared by all instances; each one keeps to its own key namespace (CASTOR_INSTANCE_ID).
REDIS_PASSWORD=
S3_ACCESS_KEY=castor-root
S3_SECRET_KEY=
